---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption: string; width?: number; }
const { src, alt, caption, width = src.width } = Astro.props;
const displayWidth = Math.min(width, src.width);
---
<figure class="my-8">
  <Image class="block mx-auto" src={src} alt={alt} width={displayWidth} widths={[320, 640, displayWidth].filter((value, index, all) => value <= displayWidth && all.indexOf(value) === index)} sizes={`(max-width: 640px) calc(100vw - 48px), ${displayWidth}px`} format="webp" quality={85} loading="lazy" decoding="async" />
  <figcaption class="mx-auto" style={`max-width: ${displayWidth}px`}>{caption}</figcaption>
</figure>
